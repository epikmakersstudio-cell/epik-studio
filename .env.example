# Copy to .env.local (or set in Vercel > Project > Settings > Environment Variables).

# Address of the Epikmakers API (the epik-studio-api repo), without a trailing slash.
# Leave empty to run the site as a preview with no backend: no sign-in, sample reviews,
# bundled gallery photos, and booking/contact forms that don't send anything.
# Setting it switches on sign-in, the members-only site lock, the admin dashboard at /admin,
# and live photos, reviews, messages and bookings, all at once.
VITE_API_URL=
